<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape><size android:height="4dp"/><corners android:radius="2dp"/><solid android:color="@color/indigo_soft"/></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape><size android:height="4dp"/><corners android:radius="2dp"/><solid android:color="@color/saffron"/></shape>
        </scale>
    </item>
</layer-list>
